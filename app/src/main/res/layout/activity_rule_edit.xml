<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/primary"
            android:layout_margin="-16dp"
            android:layout_marginBottom="16dp"
            android:elevation="4dp" />

        <!-- 基础信息卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="规则名称"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/et_rule_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="例如：银行验证码转发"
                android:maxLines="1"
                android:padding="14dp"
                android:background="@drawable/edittext_bg"
                android:textSize="15sp" />

        </LinearLayout>

        <!-- 匹配条件卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="匹配条件"
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <!-- 关键词匹配 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="关键词"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <Spinner
                    android:id="@+id/sp_keyword_mode"
                    android:layout_width="100dp"
                    android:layout_height="44dp"
                    android:background="@drawable/spinner_bg"
                    android:layout_marginEnd="8dp" />

                <EditText
                    android:id="@+id/et_keyword"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="关键词（留空表示任意）"
                    android:maxLines="1"
                    android:padding="12dp"
                    android:background="@drawable/edittext_bg"
                    android:textSize="14sp" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="且"
                android:textSize="15sp"
                android:textStyle="bold"
                android:gravity="center"
                android:textColor="@color/primary"
                android:layout_marginBottom="12dp" />

            <!-- 号码匹配 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="发送者号码"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Spinner
                    android:id="@+id/sp_sender_mode"
                    android:layout_width="100dp"
                    android:layout_height="44dp"
                    android:background="@drawable/spinner_bg"
                    android:layout_marginEnd="8dp" />

                <EditText
                    android:id="@+id/et_sender_pattern"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="号码（留空表示任意）"
                    android:maxLines="1"
                    android:inputType="phone"
                    android:padding="12dp"
                    android:background="@drawable/edittext_bg"
                    android:textSize="14sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- 执行动作卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="执行动作"
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <Spinner
                android:id="@+id/sp_action"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/spinner_bg"
                android:layout_marginBottom="12dp" />

            <!-- 回复内容 -->
            <LinearLayout
                android:id="@+id/layout_reply"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="回复内容"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/et_reply_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="自动回复的短信内容"
                    android:minLines="3"
                    android:gravity="top"
                    android:padding="12dp"
                    android:background="@drawable/edittext_bg"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- 转发目标 -->
            <LinearLayout
                android:id="@+id/layout_forward"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="转发目标"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tv_forward_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="@color/primary"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/et_forward_target"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:inputType="text"
                    android:padding="12dp"
                    android:background="@drawable/edittext_bg"
                    android:textSize="14sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- 保存按钮 -->
        <Button
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="保存规则"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/btn_primary_bg"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:textAllCaps="false" />

    </LinearLayout>

</ScrollView>
